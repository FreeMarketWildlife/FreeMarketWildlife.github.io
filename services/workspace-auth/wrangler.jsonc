{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fmw-workspaces",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern":"freemarketwildlife.com/*", "zone_id":"f676247ffd5c08516d90651c43e4a379"},
    {"pattern":"www.freemarketwildlife.com/*", "zone_id":"f676247ffd5c08516d90651c43e4a379"}
  ],
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "vars": {
    "SITE_ORIGIN": "https://freemarketwildlife.com",
    "GOOGLE_CLIENT_ID": "499695335272-qtmalu78mmughqkgslpe6dsh3b8563ef.apps.googleusercontent.com",
    "OWNER_EMAIL": "freemarketwildlife@gmail.com",
    "PUBLIC_DATA_PASSTHROUGH": "github-pages"
  },
  "d1_databases": [{"binding":"DB", "database_name":"fmw-workspaces", "database_id":"37f92822-702f-42ba-904d-9b36235e6a07", "migrations_dir":"migrations"}]
}
