  "sequences": {
    "opening": {
      "id": "opening",
      "name": "opening",
      "cards": [
        {
          "type": "dialogue",
          "speaker": "Father",
          "text": "You have opportunities here, Janey. And you spend your time with Jessie in Recyke.",
          "source": "prototype",
          "duration": 3444
        },
        {
          "type": "dialogue",
          "speaker": "Janey",
          "text": "You say that as if where he lives tells you who he is.",
          "source": "prototype",
          "duration": 2400
        },
        {
          "type": "dialogue",
          "speaker": "Guest",
          "text": "Turn on the news. Now.",
          "source": "prototype",
          "duration": 2400
        },
        {
          "type": "dialogue",
          "speaker": "Broadcast",
          "text": "Nexus enforcement is deploying drones and robots to Recyke. Anyone remaining is in danger of death. Uninvolved residents must leave immediately.",
          "source": "prototype",
          "duration": 6048
        },
        {
          "type": "title",
          "text": "The abandoned module let Nexus track Jessie.\nRecyke is under attack.",
          "duration": 3400
        },
        {
          "type": "dialogue",
          "speaker": "Janey",
          "text": "Jessie’s still there. I’m taking the cruiser.",
          "source": "prototype",
          "duration": 2400
        }
      ]
    },
    "departure": {
      "id": "departure",
      "name": "departure",
      "cards": [
        {
          "type": "dialogue",
          "speaker": "Janey",
          "text": "Hold on, Jessie. I’m coming.",
          "source": "prototype",
          "duration": 2400
        }
      ]
    }
  },
